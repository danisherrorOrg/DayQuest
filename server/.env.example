MONGO_URI=mongodb://127.0.0.1:27017/day-story
JWT_SECRET=change-this-to-a-long-random-string
PORT=4000
# Also used as the base URL for verification/reset links sent in emails.
CORS_ORIGIN=http://localhost:5173

# Email sending (verification + password reset). If SMTP_HOST is left unset, emails are
# logged to the server console instead of sent — handy for local dev without a real mailbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Day Story <no-reply@dayquest.local>

# Hour (UTC, 0-23) each day the "you haven't logged today" reminder email
# job runs. There's no per-user timezone, so this is one global cutoff —
# also depends on SMTP_HOST above being set to actually send anything.
REMINDER_HOUR_UTC=20
